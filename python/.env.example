# Copy this file to python/.env and fill in your own Alpaca PAPER trading
# credentials (free, from https://app.alpaca.markets/paper/dashboard/overview).
# python/.env is gitignored -- never commit real credentials.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional -- powers the trading-assistant chat locally and (via
# scripts/set_trading_env.sh) on the Azure deployment. Free key from
# https://openrouter.ai/keys. Leave blank to run without it -- the chat
# just falls back to a canned "couldn't reach the assistant" reply.
OPENROUTER_API_KEY=
